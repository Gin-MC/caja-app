---
---
<div class="uploader-container">
  <div id="dropzone" class="dropzone">
    <div class="dropzone-content">
      <div class="icon-circle">
        <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="17 8 12 3 7 8" />
          <line x1="12" y1="3" x2="12" y2="15" />
        </svg>
      </div>
      <h3>Cargar Reporte de Ventas Diarias</h3>
      <p class="dropzone-text">Arrastra tu archivo de Excel aquí o haz clic para examinar</p>
      <p class="dropzone-hint">Soporta formatos (.xls, .xlsx)</p>
    </div>
    <input type="file" id="file-input" class="file-input" accept=".xls,.xlsx" />
  </div>

  <div id="file-loading-indicator" class="loading-indicator hidden">
    <div class="spinner"></div>
    <span id="loading-text">Procesando archivo de ventas...</span>
  </div>

  <div id="loaded-file-badge" class="loaded-badge hidden">
    <div class="badge-content">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
        <polyline points="14 2 14 8 20 8" />
        <line x1="16" y1="13" x2="8" y2="13" />
        <line x1="16" y1="17" x2="8" y2="17" />
        <polyline points="10 9 9 9 8 9" />
      </svg>
      <div class="badge-text">
        <span class="file-name" id="loaded-file-name">reporte.xlsx</span>
        <span class="file-date" id="loaded-file-date">1 de Abril de 2026</span>
      </div>
    </div>
    <div class="badge-actions">
      <button id="clear-all-data-btn" class="btn-clear-data" type="button" title="Limpiar toda la información y reiniciar">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6" />
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
        </svg>
        Limpiar Información
      </button>
      <button id="clear-file-btn" class="clear-btn" title="Cargar otro archivo">&times;</button>
    </div>
  </div>
</div>

<style>
  .uploader-container {
    width: 100%;
    margin-bottom: 2rem;
  }

  .dropzone {
    background-color: var(--color-white);
    border: 2.5px dashed var(--color-border);
    border-radius: 20px;
    padding: 3rem 2rem;
    text-align: center;
    cursor: pointer;
    position: relative;
    transition: var(--transition-smooth);
    box-shadow: 0 4px 20px var(--color-shadow);
  }

  .dropzone:hover, .dropzone.dragover {
    border-color: var(--color-orange);
    background-color: rgba(230, 126, 34, 0.02);
  }

  .dropzone-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    pointer-events: none;
  }

  .icon-circle {
    width: 72px;
    height: 72px;
    background-color: var(--color-cream);
    color: var(--color-orange);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-smooth);
    border: 1px solid var(--color-border);
  }

  .dropzone:hover .icon-circle {
    background-color: var(--color-orange);
    color: var(--color-white);
    transform: scale(1.05);
    box-shadow: 0 8px 20px rgba(230, 126, 34, 0.15);
  }

  .dropzone-content h3 {
    font-size: 1.15rem;
    color: var(--color-dark);
  }

  .dropzone-text {
    font-size: 0.9rem;
    color: var(--color-dark-muted);
  }

  .dropzone-hint {
    font-size: 0.75rem;
    color: var(--color-dark-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .file-input {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  /* Loaded Badge */
  .loaded-badge {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 4px 15px var(--color-shadow);
    animation: slideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .badge-content {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-orange);
  }

  .badge-text {
    display: flex;
    flex-direction: column;
  }

  .file-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-dark);
  }

  .file-date {
    font-size: 0.78rem;
    color: var(--color-dark-muted);
  }

  .badge-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-clear-data {
    background-color: var(--color-error-bg);
    color: var(--color-error);
    border: 1px solid #F5B7B1;
    border-radius: 10px;
    padding: 0.45rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: var(--transition-smooth);
    font-family: var(--font-primary);
  }

  .btn-clear-data:hover {
    background-color: var(--color-error);
    color: var(--color-white);
    border-color: var(--color-error);
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(192, 57, 43, 0.2);
  }

  .clear-btn {
    background: none;
    border: none;
    font-size: 1.8rem;
    color: var(--color-dark-muted);
    cursor: pointer;
    line-height: 1;
    transition: var(--transition-smooth);
    padding: 0 0.5rem;
  }

  .clear-btn:hover {
    color: var(--color-error);
    transform: scale(1.1);
  }

  /* Loading indicator */
  .loading-indicator {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    box-shadow: 0 4px 15px var(--color-shadow);
  }

  .spinner {
    width: 24px;
    height: 24px;
    border: 3px solid var(--color-border);
    border-top: 3px solid var(--color-orange);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hidden {
    display: none !important;
  }
</style>
