---
interface Props {
  className?: string;
  showTagline?: boolean;
}

const { className = "", showTagline = true } = Astro.props;
---

<div class={`logo-container ${className}`}>
  <div class="logo-graphic">
    <!-- Icon 1: Bolsa -->
    <div class="logo-box">
      <svg viewBox="0 0 100 100" class="logo-svg">
        <rect x="10" y="10" width="80" height="80" rx="20" fill="var(--color-orange)" />
        <!-- Handled plastic bag path -->
        <path d="M35,35 L35,28 C35,23.5 38.5,20 43,20 L57,20 C61.5,20 65,23.5 65,28 L65,35 L70,35 L70,80 L30,80 L30,35 L35,35 Z" fill="none" stroke="var(--color-white)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M43,35 C43,30 57,30 57,35" fill="none" stroke="var(--color-white)" stroke-width="6" stroke-linecap="round" />
      </svg>
    </div>

    <!-- Icon 2: Rollo -->
    <div class="logo-box">
      <svg viewBox="0 0 100 100" class="logo-svg">
        <rect x="10" y="10" width="80" height="80" rx="20" fill="var(--color-orange)" />
        <!-- Roll of paper/plastic towel path -->
        <path d="M35,30 L65,30 C72,30 72,42 65,42 L35,42 C28,42 28,30 35,30 Z" fill="none" stroke="var(--color-white)" stroke-width="6" stroke-linejoin="round" />
        <ellipse cx="65" cy="36" rx="5" ry="6" fill="none" stroke="var(--color-white)" stroke-width="5" />
        <path d="M30,36 L30,70 C30,75 35,78 45,78 L65,78 L65,42" fill="none" stroke="var(--color-white)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>

    <!-- Icon 3: Vaso con Cañita -->
    <div class="logo-box">
      <svg viewBox="0 0 100 100" class="logo-svg">
        <rect x="10" y="10" width="80" height="80" rx="20" fill="var(--color-orange)" />
        <!-- Cup with straw -->
        <path d="M35,35 L65,35 L60,80 L40,80 Z" fill="none" stroke="var(--color-white)" stroke-width="6" stroke-linejoin="round" />
        <line x1="30" y1="35" x2="70" y2="35" stroke="var(--color-white)" stroke-width="6" stroke-linecap="round" />
        <path d="M50,35 L50,23 L62,18" fill="none" stroke="var(--color-white)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
  </div>

  <div class="logo-text-block">
    <div class="logo-brand">
      <span class="text-orange">Plasti</span><span class="text-dark">luz</span>
    </div>
    {showTagline && (
      <div class="logo-tagline">
        Lo mejor en bolsas, descartables, embalajes y más
      </div>
    )}
  </div>
</div>

<style>
  .logo-container {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .logo-graphic {
    display: flex;
    gap: 0.25rem;
  }

  .logo-box {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition-smooth);
  }

  .logo-box:hover {
    transform: translateY(-2px);
  }

  .logo-svg {
    width: 100%;
    height: 100%;
  }

  .logo-text-block {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .logo-brand {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.5px;
  }

  .text-orange {
    color: var(--color-orange);
  }

  .text-dark {
    color: var(--color-dark);
  }

  .logo-tagline {
    font-size: 0.72rem;
    color: var(--color-dark-muted);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0.1px;
    margin-top: 0.1rem;
  }

  /* Responsive styling */
  @media (max-width: 640px) {
    .logo-container {
      gap: 0.5rem;
    }
    .logo-box {
      width: 32px;
      height: 32px;
    }
    .logo-brand {
      font-size: 1.6rem;
    }
    .logo-tagline {
      font-size: 0.65rem;
    }
  }
</style>
